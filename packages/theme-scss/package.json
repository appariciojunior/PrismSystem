{
  "name": "@ds/theme-scss",
  "version": "2.0.0",
  "type": "module",
  "description": "Design System theme package - pre-resolved color tokens for React",
  "keywords": [
    "design-system",
    "theme",
    "tokens",
    "scss"
  ],
  "author": "douglasmik <michael@viaverso.co.uk>",
  "license": "ISC",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./ds-layout.scss": "./dist/ds-layout.scss",
    "./ds-typography.scss": "./dist/ds-typography.scss",
    "./variables.css": "./dist/variables.css",
    "./palettes/*": "./dist/palettes/*"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/design-system.git"
  },
  "scripts": {
    "build": "npm run clean && npm run build:rollup",
    "build:rollup": "rollup -c",
    "clean": "rimraf dist",
    "dev": "rollup -c --watch",
    "prepublishOnly": "npm run build",
    "test": "node ./__tests__/*.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/your-org/design-system/issues"
  },
  "homepage": "https://github.com/your-org/design-system#readme"
}
